% references.bib -- Phase 1 proposal (biblatex + biber)
% Cite in text with \cite{key}. Only cited entries appear in the reference list.
% For datasets and web pages use @online; include urldate (date you accessed it).
%
% Example (remove the leading % signs and fill in):
% @online{key2026,
%   author   = {[Author or Organization]},
%   title    = {[Title]},
%   year     = {[Year]},
%   url      = {[URL]},
%   urldate  = {[YYYY-MM-DD]},
%   note     = {[Licence, version, or other note]}
% }
